# ---------------------------------------------------------------------------
# Rentora API — environment variables (names only, copy to `.env` locally and
# to the Vercel project settings for production).
#
# Values below are placeholders: replace them with your own. Never commit the
# real `.env` file.
# ---------------------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas or a local mongod).
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Database name. MUST match the value used by the frontend project
# (default: rental-platform) or session verification will not find the user.
DB_NAME=rental-platform

# Shared with the frontend project. The session cookie is signed with this
# value, so both projects MUST use the exact same secret or every API request
# will be rejected as unauthenticated. Generate one with:
#   npx @better-auth/cli secret
BETTER_AUTH_SECRET=<same-value-as-the-frontend>

# Public URL of THIS API (used by Better Auth as its base URL).
# Local:  http://localhost:5000
# Vercel: https://<your-api-project>.vercel.app
BETTER_AUTH_URL=http://localhost:5000

# Public URL of the frontend. Used for CORS (comma-separated for several
# origins) and for Stripe success/cancel redirects.
# Local:  http://localhost:3000
# Vercel: https://<your-frontend-project>.vercel.app
CLIENT_URL=http://localhost:3000

# Optional. Extra origins allowed by CORS, comma-separated.
# CORS_ORIGINS=https://www.example.com,https://staging.example.com

# Optional. Local port for `node index.js` (Vercel ignores this).
# PORT=5000

# Stripe (server-side only)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional, defaults to "bdt"
# STRIPE_CURRENCY=bdt

# Cloudinary
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
